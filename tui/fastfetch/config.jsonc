{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#yellow}{user-name}{#magenta}@{#cyan}{host-name}{#} ~{#}",
    },
    {
      "type": "os",
      "key": "{#cyan}󰟀  {#blue}System       {#bright_black}┆{#}",
      "format": "{2}",
    },
    {
      "type": "wm",
      "key": "{#cyan}  {#blue}Desktop      {#bright_black}┆{#}",
      "format": "{1} ({3})",
    },
    {
      "type": "kernel",
      "key": "{#cyan}  {#blue}Kernel       {#bright_black}┆{#}",
    },
    {
      "type": "cpu",
      "key": "{#cyan}  {#blue}CPU          {#bright_black}┆{#}",
    },
    {
      "type": "memory",
      "key": "{#cyan}  {#blue}Memory       {#bright_black}┆{#}",
      "format": "{1} / {2} ({3})",
    },
    {
      "type": "disk",
      "key": "{#cyan}󱥎  {#blue}Storage (/)  {#bright_black}┆{#}",
      "folders": "/",
      "format": "{1} / {2} ({3})",
    },
    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "{#yellow}󰮯 {#green}󰊠 {#cyan}󰊠 {#red}󰊠 {#blue}󰊠 {#magenta}󰊠 {#white}󰊠 {#bright_black}󰊠{#}",
    },
    "break",
  ],
}
