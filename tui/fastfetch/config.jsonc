{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2,
    },
  },
  "display": {
    "separator": " | ",
  },
  "modules": [
    "break",
    "title",
    {
      "type": "os",
      "key": "system ",
      "format": "{2}",
    },
    {
      "type": "wm",
      "key": "desktop",
      "format": "{1} {5}",
    },
    {
      "type": "kernel",
      "key": "kernel ",
    },
    {
      "type": "cpu",
      "key": "cpu    ",
    },
    {
      "type": "memory",
      "key": "ram    ",
      "format": "{1} / {2} ({3})",
    },
    {
      "type": "disk",
      "key": "disk   ",
      "folders": "/",
      "format": "{1} / {2} ({3})",
    },
    {
      "type": "colors",
      "symbol": "circle",
    },
    "break",
  ],
}
