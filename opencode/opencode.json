{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "mcp": {
    "servers": {
      "excalidraw": {
        "type": "remote",
        "url": "https://mcp.excalidraw.com/mcp"
      },
      "browse": {
        "type": "local",
        "command": [
          "/home/dominic/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
