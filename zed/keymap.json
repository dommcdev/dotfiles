// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // Pane tab controls. Matching Editor and Terminal explicitly makes these
  // bindings take precedence at the lowest active context node.
  {
    "context": "(Pane || Editor || Terminal) && !menu",
    "bindings": {
      // Select a tab in the currently focused pane.
      "ctrl-space 1": ["pane::ActivateItem", 0],
      "ctrl-space 2": ["pane::ActivateItem", 1],
      "ctrl-space 3": ["pane::ActivateItem", 2],
      "ctrl-space 4": ["pane::ActivateItem", 3],
      "ctrl-space 5": ["pane::ActivateItem", 4],
      "ctrl-space 6": ["pane::ActivateItem", 5],
      "ctrl-space 7": ["pane::ActivateItem", 6],
      "ctrl-space 8": ["pane::ActivateItem", 7],
      "ctrl-space 9": ["pane::ActivateItem", 8],
      "ctrl-space 0": "pane::ActivateLastItem",

      // The terminal overrides tab creation below.
      "ctrl-space c": "workspace::NewFile",
      "ctrl-space x": ["pane::CloseActiveItem", { "close_pinned": false }],
      "ctrl-w c": "workspace::NewFile",
      "ctrl-w x": ["pane::CloseActiveItem", { "close_pinned": false }],

      // Move between panes.
      "ctrl-space h": "workspace::ActivatePaneLeft",
      "ctrl-space j": "workspace::ActivatePaneDown",
      "ctrl-space k": "workspace::ActivatePaneUp",
      "ctrl-space l": "workspace::ActivatePaneRight",
      "ctrl-w h": "workspace::ActivatePaneLeft",
      "ctrl-w j": "workspace::ActivatePaneDown",
      "ctrl-w k": "workspace::ActivatePaneUp",
      "ctrl-w l": "workspace::ActivatePaneRight"
    }
  },

  // Creates another terminal tab in the focused center pane.
  {
    "context": "Terminal && !menu",
    "bindings": {
      "ctrl-space c": "workspace::NewCenterTerminal",
      "ctrl-w c": "workspace::NewCenterTerminal",

      // Forward terminal control keys instead of invoking Zed actions. ctrl-space
      // and ctrl-w remain available as the pane-control prefixes above.
      "ctrl-a": ["terminal::SendKeystroke", "ctrl-a"],
      "ctrl-b": ["terminal::SendKeystroke", "ctrl-b"],
      "ctrl-c": ["terminal::SendKeystroke", "ctrl-c"],
      "ctrl-d": ["terminal::SendKeystroke", "ctrl-d"],
      "ctrl-e": ["terminal::SendKeystroke", "ctrl-e"],
      "ctrl-f": ["terminal::SendKeystroke", "ctrl-f"],
      "ctrl-g": ["terminal::SendKeystroke", "ctrl-g"],
      "ctrl-h": ["terminal::SendKeystroke", "ctrl-h"],
      "ctrl-i": ["terminal::SendKeystroke", "ctrl-i"],
      "ctrl-j": ["terminal::SendKeystroke", "ctrl-j"],
      "ctrl-k": ["terminal::SendKeystroke", "ctrl-k"],
      "ctrl-l": ["terminal::SendKeystroke", "ctrl-l"],
      "ctrl-m": ["terminal::SendKeystroke", "ctrl-m"],
      "ctrl-n": ["terminal::SendKeystroke", "ctrl-n"],
      "ctrl-o": ["terminal::SendKeystroke", "ctrl-o"],
      "ctrl-p": ["terminal::SendKeystroke", "ctrl-p"],
      "ctrl-q": ["terminal::SendKeystroke", "ctrl-q"],
      "ctrl-r": ["terminal::SendKeystroke", "ctrl-r"],
      "ctrl-s": ["terminal::SendKeystroke", "ctrl-s"],
      "ctrl-t": ["terminal::SendKeystroke", "ctrl-t"],
      "ctrl-u": ["terminal::SendKeystroke", "ctrl-u"],
      "ctrl-v": ["terminal::SendKeystroke", "ctrl-v"],
      "ctrl-x": ["terminal::SendKeystroke", "ctrl-x"],
      "ctrl-y": ["terminal::SendKeystroke", "ctrl-y"],
      "ctrl-z": ["terminal::SendKeystroke", "ctrl-z"],
      "ctrl-[": ["terminal::SendKeystroke", "ctrl-["],
      "ctrl-\\": ["terminal::SendKeystroke", "ctrl-\\"],
      "ctrl-]": ["terminal::SendKeystroke", "ctrl-]"],
      "ctrl-^": ["terminal::SendKeystroke", "ctrl-^"],
      "ctrl-_": ["terminal::SendKeystroke", "ctrl-_"]
    }
  },

  // Command palette instead of file finder. The terminal-local ctrl-p binding
  // above takes precedence over this pane-level fallback.
  {
    "context": "(Workspace || Pane || Editor) && !menu",
    "bindings": {
      "ctrl-p": "command_palette::Toggle"
    }
  },

  // Vim normal-mode leader binding: copy the entire current buffer
  // to the system clipboard, then clear the temporary selection.
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "space shift-y": [
        "action::Sequence",
        ["editor::SelectAll", "editor::Copy", "editor::Cancel"]
      ]
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g o": "vim::StartOfDocument"
    }
  },
  {
    "context": "VimControl && !VimWaiting && !menu",
    "bindings": {
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space s f": "file_finder::Toggle",
      "space s g": "pane::DeploySearch",
      "space ,": "tab_switcher::Toggle"
    }
  },
  {
    "context": "Picker",
    "bindings": {
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious"
    }
  }
]
