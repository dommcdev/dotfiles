HTML_START

printf '<script id="commits-data" type="application/octet-stream">%s</script>\n' "$(encode_file "$COMMITS_DATA")"
printf '<script id="todo-data" type="application/octet-stream">%s</script>\n' "$(encode_file "$TODO_DATA")"
printf '<script id="meta-data" type="application/octet-stream">%s</script>\n' "$(encode_file "$META_DATA")"

cat <<'HTML_END'
<script>
(() => {
    'use strict';

    const $ = id => document.getElementById(id);
    const decode = id => new TextDecoder().decode(Uint8Array.from(atob($(id).textContent.trim()), c => c.charCodeAt(0)));
    const esc = value => String(value).replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
    const number = value => new Intl.NumberFormat('en', { notation: value >= 100000 ? 'compact' : 'standard', maximumFractionDigits: 1 }).format(value);
    const fullNumber = value => new Intl.NumberFormat('en').format(value);
    const pct = value => `${Math.round(value * 100)}%`;
    const dateKey = date => date.toISOString().slice(0, 10);
    const monthKey = date => dateKey(date).slice(0, 7);
    const dayMs = 86400000;

    const [repoName, branch, generatedEpoch, todoPath] = decode('meta-data').split('\x1f');
    const commits = decode('commits-data').split('\x1e').filter(Boolean).map(record => {
        const lines = record.replace(/^\n/, '').split('\n');
        const [hash, date, epoch, author, email, subject] = lines.shift().split('\x1f');
        const files = [];
        let additions = 0;
        let deletions = 0;
        let binaryFiles = 0;
        for (const line of lines) {
            if (!line) continue;
            const firstTab = line.indexOf('\t');
            const secondTab = line.indexOf('\t', firstTab + 1);
            if (firstTab < 0 || secondTab < 0) continue;
            const addedRaw = line.slice(0, firstTab);
            const deletedRaw = line.slice(firstTab + 1, secondTab);
            const path = line.slice(secondTab + 1);
            const binary = addedRaw === '-' || deletedRaw === '-';
            const added = binary ? 0 : Number(addedRaw);
            const deleted = binary ? 0 : Number(deletedRaw);
            if (binary) binaryFiles++;
            additions += added;
            deletions += deleted;
            files.push({ path, added, deleted, binary });
        }
        const timestamp = Number(epoch) * 1000;
        return { hash, date, timestamp, author, email, subject: subject || '(no subject)', files, additions, deletions, binaryFiles };
    }).sort((a, b) => a.timestamp - b.timestamp);

    const todo = decode('todo-data').split('\x1e').filter(Boolean).map(record => {
        const [date, count] = record.split('\x1f');
        return { date, count: Number(count) };
    }).reverse();

    if (!commits.length) {
        document.body.innerHTML = '<main class="shell"><h1>No commits found</h1></main>';
        return;
    }

    const byDay = new Map();
    const byMonth = new Map();
    const byAuthor = new Map();
    const byFile = new Map();
    const byExtension = new Map();
    const weekdays = Array(7).fill(0);
    const hours = Array(24).fill(0);
    let additions = 0;
    let deletions = 0;
    let filesChanged = 0;
    let binaryChanges = 0;

    const extensionFor = path => {
        const clean = path.replace(/^"|"$/g, '');
        const name = clean.split('/').pop();
        if (!name || !name.includes('.') || name.startsWith('.') && name.indexOf('.', 1) < 0) return '[no extension]';
        return `.${name.split('.').pop().toLowerCase()}`;
    };

    for (const commit of commits) {
        const day = byDay.get(commit.date) || { commits: 0, additions: 0, deletions: 0 };
        day.commits++;
        day.additions += commit.additions;
        day.deletions += commit.deletions;
        byDay.set(commit.date, day);

        const month = commit.date.slice(0, 7);
        const monthStats = byMonth.get(month) || { commits: 0, additions: 0, deletions: 0 };
        monthStats.commits++;
        monthStats.additions += commit.additions;
        monthStats.deletions += commit.deletions;
        byMonth.set(month, monthStats);

        const authorKey = commit.email.toLowerCase() || commit.author;
        const author = byAuthor.get(authorKey) || { name: commit.author, commits: 0, additions: 0, deletions: 0 };
        author.commits++;
        author.additions += commit.additions;
        author.deletions += commit.deletions;
        byAuthor.set(authorKey, author);

        const localDate = new Date(commit.timestamp);
        weekdays[localDate.getDay()]++;
        hours[localDate.getHours()]++;
        additions += commit.additions;
        deletions += commit.deletions;
        filesChanged += commit.files.length;
        binaryChanges += commit.binaryFiles;

        for (const file of commit.files) {
            const fileStats = byFile.get(file.path) || { changes: 0, commits: 0 };
            fileStats.changes += file.added + file.deleted;
            fileStats.commits++;
            byFile.set(file.path, fileStats);
            const extension = extensionFor(file.path);
            const extensionStats = byExtension.get(extension) || { changes: 0, files: new Set() };
            extensionStats.changes += file.added + file.deleted;
            extensionStats.files.add(file.path);
            byExtension.set(extension, extensionStats);
        }
    }

    const activeDates = [...byDay.keys()].sort();
    const firstDate = activeDates[0];
    const lastDate = activeDates.at(-1);
    const spanDays = Math.floor((new Date(`${lastDate}T12:00:00`) - new Date(`${firstDate}T12:00:00`)) / dayMs) + 1;
    const trackedFiles = new Set([...byFile.keys()]).size;
    const currentTodo = todo.length ? todo.at(-1).count : 0;

    let longestStreak = 1;
    let runningStreak = 1;
    let longestStart = firstDate;
    let longestEnd = firstDate;
    let runningStart = firstDate;
    for (let i = 1; i < activeDates.length; i++) {
        const gap = Math.round((new Date(`${activeDates[i]}T12:00:00`) - new Date(`${activeDates[i - 1]}T12:00:00`)) / dayMs);
        if (gap === 1) {
            runningStreak++;
        } else {
            runningStreak = 1;
            runningStart = activeDates[i];
        }
        if (runningStreak > longestStreak) {
            longestStreak = runningStreak;
            longestStart = runningStart;
            longestEnd = activeDates[i];
        }
    }

    let currentStreak = 1;
    for (let i = activeDates.length - 1; i > 0; i--) {
        const gap = Math.round((new Date(`${activeDates[i]}T12:00:00`) - new Date(`${activeDates[i - 1]}T12:00:00`)) / dayMs);
        if (gap !== 1) break;
        currentStreak++;
    }

    const busiestDay = [...byDay].sort((a, b) => b[1].commits - a[1].commits)[0];
    const biggestCommit = [...commits].sort((a, b) => (b.additions + b.deletions) - (a.additions + a.deletions))[0];
    const topMonth = [...byMonth].sort((a, b) => b[1].commits - a[1].commits)[0];
    const topWeekday = weekdays.indexOf(Math.max(...weekdays));
    const topHour = hours.indexOf(Math.max(...hours));
    const weekdayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

    $('repoName').textContent = repoName;
    $('branch').textContent = branch;
    $('historyWindow').textContent = `${firstDate} -> ${lastDate}`;
    $('generatedAt').textContent = new Date(Number(generatedEpoch) * 1000).toLocaleString();
    $('todoSubtitle').textContent = todoPath ? `Non-empty lines in ${todoPath}` : 'No todo.txt or todo.md found';
    document.title = `${repoName} / Productivity`;

    const metrics = [
        ['Total commits', fullNumber(commits.length), `${number(commits.length / Math.max(spanDays / 365.25, 1))} per year`],
        ['Lines added', `+${number(additions)}`, `${pct(additions / Math.max(additions + deletions, 1))} of churn`],
        ['Lines removed', `-${number(deletions)}`, `net ${additions - deletions >= 0 ? '+' : ''}${number(additions - deletions)}`],
        ['Active days', fullNumber(activeDates.length), `${pct(activeDates.length / spanDays)} of ${fullNumber(spanDays)} days`],
        ['Contributors', fullNumber(byAuthor.size), `${fullNumber(trackedFiles)} historical files`],
        ['Open todos', fullNumber(currentTodo), `${fullNumber(todo.length)} snapshots`],
        ['Longest streak', `${longestStreak}d`, `${longestStart} -> ${longestEnd}`],
        ['Current streak', `${currentStreak}d`, `ending ${lastDate}`],
        ['Avg active day', number(commits.length / activeDates.length), 'commits per active day'],
        ['Avg commit size', number((additions + deletions) / commits.length), 'lines changed'],
        ['Files / commit', number(filesChanged / commits.length), `${fullNumber(binaryChanges)} binary changes`],
        ['Repository age', `${number(spanDays / 365.25)}y`, `${firstDate} first commit`]
    ];
    $('metrics').innerHTML = metrics.map(([label, value, note]) => `<article class="metric"><div class="metric-label">${esc(label)}</div><div class="metric-value">${esc(value)}</div><div class="metric-note">${esc(note)}</div></article>`).join('');

    const recordItems = [
        ['Busiest day', `${busiestDay[1].commits} commits`, busiestDay[0]],
        ['Best month', `${topMonth[1].commits} commits`, topMonth[0]],
        ['Largest commit', number(biggestCommit.additions + biggestCommit.deletions), biggestCommit.subject],
        ['Peak rhythm', `${weekdayNames[topWeekday]} ${String(topHour).padStart(2, '0')}:00`, 'most frequent day / hour'],
        ['Code survival', pct(Math.max(additions - deletions, 0) / Math.max(additions, 1)), 'net additions / additions'],
        ['Change volume', number(additions + deletions), 'total line churn']
    ];
    $('records').innerHTML = recordItems.map(([label, value, note]) => `<div class="record"><div class="mini-label">${esc(label)}</div><div class="record-value">${esc(value)}</div><div class="record-note" title="${esc(note)}">${esc(note)}</div></div>`).join('');

    function svgBars(target, labels, values, options = {}) {
        const width = 760;
        const height = options.height || 270;
        const margin = { top: 12, right: 12, bottom: 35, left: 52 };
        const plotWidth = width - margin.left - margin.right;
        const plotHeight = height - margin.top - margin.bottom;
        const max = Math.max(...values, 1);
        const step = plotWidth / values.length;
        const barWidth = Math.max(2, step * .68);
        let svg = `<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="${esc(options.label || 'Bar chart')}">`;
        for (let i = 0; i <= 4; i++) {
            const y = margin.top + plotHeight * i / 4;
            const value = max * (1 - i / 4);
            svg += `<line class="grid-line" x1="${margin.left}" y1="${y}" x2="${width - margin.right}" y2="${y}"/><text class="axis-text" x="${margin.left - 8}" y="${y + 3}" text-anchor="end">${number(value)}</text>`;
        }
        values.forEach((value, i) => {
            const barHeight = value / max * plotHeight;
            const x = margin.left + i * step + (step - barWidth) / 2;
            const y = margin.top + plotHeight - barHeight;
            svg += `<rect x="${x}" y="${y}" width="${barWidth}" height="${barHeight}" fill="${options.color || '#ff6b00'}"><title>${esc(labels[i])}: ${fullNumber(value)}</title></rect>`;
            const labelEvery = options.labelEvery || Math.max(1, Math.ceil(values.length / 10));
            if (i % labelEvery === 0 || i === values.length - 1) svg += `<text class="axis-text" x="${x + barWidth / 2}" y="${height - 12}" text-anchor="middle">${esc(options.formatLabel ? options.formatLabel(labels[i]) : labels[i])}</text>`;
        });
        svg += '</svg>';
        $(target).innerHTML = svg;
    }

    function svgLines(target, labels, series, options = {}) {
        const width = 1100;
        const height = options.height || 300;
        const margin = { top: 12, right: 15, bottom: 36, left: 58 };
        const plotWidth = width - margin.left - margin.right;
        const plotHeight = height - margin.top - margin.bottom;
        const allValues = series.flatMap(item => item.values);
        const max = Math.max(...allValues, 1);
        const xFor = i => margin.left + (labels.length === 1 ? plotWidth / 2 : i / (labels.length - 1) * plotWidth);
        const yFor = value => margin.top + plotHeight - value / max * plotHeight;
        let svg = `<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="${esc(options.label || 'Line chart')}">`;
        for (let i = 0; i <= 4; i++) {
            const y = margin.top + plotHeight * i / 4;
            svg += `<line class="grid-line" x1="${margin.left}" y1="${y}" x2="${width - margin.right}" y2="${y}"/><text class="axis-text" x="${margin.left - 8}" y="${y + 3}" text-anchor="end">${number(max * (1 - i / 4))}</text>`;
        }
        series.forEach(item => {
            const points = item.values.map((value, i) => `${xFor(i)},${yFor(value)}`).join(' ');
            svg += `<polyline points="${points}" fill="none" stroke="${item.color}" stroke-width="${item.width || 2}" vector-effect="non-scaling-stroke"/>`;
            item.values.forEach((value, i) => {
                if (labels.length < 40 || i % Math.ceil(labels.length / 40) === 0) svg += `<circle cx="${xFor(i)}" cy="${yFor(value)}" r="2" fill="${item.color}"><title>${esc(labels[i])}: ${fullNumber(value)} ${esc(item.name)}</title></circle>`;
            });
        });
        const labelEvery = Math.max(1, Math.ceil(labels.length / 8));
        labels.forEach((label, i) => {
            if (i % labelEvery === 0 || i === labels.length - 1) svg += `<text class="axis-text" x="${xFor(i)}" y="${height - 11}" text-anchor="middle">${esc(options.formatLabel ? options.formatLabel(label) : label)}</text>`;
        });
        svg += '</svg>';
        $(target).innerHTML = svg;
    }

    const months = [...byMonth.keys()].sort();
    svgBars('commitChart', months, months.map(month => byMonth.get(month).commits), {
        label: 'Commits per month',
        formatLabel: month => month.slice(2)
    });
    svgLines('churnChart', months, [
        { name: 'added', values: months.map(month => byMonth.get(month).additions), color: '#ff6b00', width: 2.5 },
        { name: 'removed', values: months.map(month => byMonth.get(month).deletions), color: '#8a3b08', width: 2 }
    ], { label: 'Lines added and removed per month', formatLabel: month => month.slice(2) });

    const todoLabels = todo.map(item => item.date);
    if (todo.length) {
        svgLines('todoChart', todoLabels, [{ name: 'todos', values: todo.map(item => item.count), color: '#ff6b00', width: 3 }], {
            label: 'Todo list line count over time',
            formatLabel: date => date.slice(2)
        });
    } else {
        $('todoChart').textContent = 'No todo history found.';
    }

    svgBars('weekdayChart', weekdayNames, weekdays, { label: 'Commits by weekday', height: 290, labelEvery: 1 });
    svgBars('hourChart', hours.map((_, hour) => String(hour).padStart(2, '0')), hours, {
        label: 'Commits by hour',
        height: 290,
        labelEvery: 3
    });

    function renderRanked(target, rows, valueFor, noteFor) {
        const max = Math.max(...rows.map(valueFor), 1);
        $(target).innerHTML = rows.map(row => {
            const value = valueFor(row);
            return `<div class="bar-row"><div class="bar-name" title="${esc(row.name)}">${esc(row.name)}</div><div class="bar-track"><div class="bar-fill" style="width:${value / max * 100}%"></div></div><div class="bar-value">${esc(noteFor(row))}</div></div>`;
        }).join('');
    }

    const fileRows = [...byFile].map(([name, stats]) => ({ name, ...stats })).sort((a, b) => b.changes - a.changes).slice(0, 12);
    renderRanked('files', fileRows, row => row.changes, row => `${number(row.changes)} / ${row.commits}c`);

    const extensionRows = [...byExtension].map(([name, stats]) => ({ name, changes: stats.changes, files: stats.files.size })).sort((a, b) => b.changes - a.changes).slice(0, 12);
    renderRanked('extensions', extensionRows, row => row.changes, row => `${number(row.changes)} / ${row.files}f`);

    const contributorRows = [...byAuthor.values()].sort((a, b) => b.commits - a.commits).slice(0, 10).map(author => ({ ...author, name: author.name || 'Unknown' }));
    renderRanked('contributors', contributorRows, row => row.commits, row => `${row.commits} / ${number(row.additions + row.deletions)}`);

    const heatEnd = new Date(`${lastDate}T12:00:00`);
    heatEnd.setDate(heatEnd.getDate() + (6 - heatEnd.getDay()));
    const heatStart = new Date(heatEnd);
    heatStart.setDate(heatStart.getDate() - 363);
    const heatValues = [];
    for (let cursor = new Date(heatStart); cursor <= heatEnd; cursor.setDate(cursor.getDate() + 1)) {
        heatValues.push({ date: dateKey(cursor), value: byDay.get(dateKey(cursor))?.commits || 0 });
    }
    const positiveHeat = heatValues.map(item => item.value).filter(Boolean).sort((a, b) => a - b);
    const threshold = quantile => positiveHeat[Math.floor((positiveHeat.length - 1) * quantile)] || 1;
    const q1 = threshold(.25);
    const q2 = threshold(.5);
    const q3 = threshold(.75);
    $('heatmap').innerHTML = heatValues.map(item => {
        const level = item.value === 0 ? 0 : item.value <= q1 ? 1 : item.value <= q2 ? 2 : item.value <= q3 ? 3 : 4;
        return `<i class="heat-cell heat-${level}"><title>${item.date}: ${item.value} commit${item.value === 1 ? '' : 's'}</title></i>`;
    }).join('');
    $('heatRange').textContent = `${dateKey(heatStart)} -> ${dateKey(heatEnd)}`;

    $('recent').innerHTML = [...commits].reverse().slice(0, 15).map(commit => `<tr><td class="hash">${esc(commit.hash.slice(0, 8))}</td><td>${esc(commit.date)}</td><td>${esc(commit.author)}</td><td class="subject" title="${esc(commit.subject)}">${esc(commit.subject)}</td><td>${commit.files.length}</td><td><span class="plus">+${fullNumber(commit.additions)}</span> <span class="minus">-${fullNumber(commit.deletions)}</span></td></tr>`).join('');
    $('footerSummary').textContent = `${fullNumber(commits.length)} COMMITS / ${fullNumber(additions + deletions)} LINES CHANGED / ${fullNumber(activeDates.length)} ACTIVE DAYS`;
})();
</script>
</body>
</html>
HTML_END
} > "$OUTPUT_HTML"

printf 'Dashboard generated at %s\n' "$OUTPUT_HTML"

if command -v open >/dev/null 2>&1; then
    open "$OUTPUT_HTML"
elif command -v xdg-open >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    xdg-open "$OUTPUT_HTML" >/dev/null 2>&1 &
else
    printf 'Open %s in your browser.\n' "$OUTPUT_HTML"
fi
