#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

OUTPUT_HTML="/tmp/productivity.html"

for command in git base64; do
    if ! command -v "$command" >/dev/null 2>&1; then
        printf 'Error: Required command not found: %s\n' "$command" >&2
        exit 1
    fi
done

TARGET_FILE=""
for candidate in todo.txt todo.md; do
    if [ -f "$candidate" ]; then
        TARGET_FILE="$candidate"
        break
    fi
done
if [ -z "$TARGET_FILE" ]; then
    TARGET_FILE="$(git ls-files | awk -F/ '!found && ($NF == "todo.txt" || $NF == "todo.md") { print; found = 1 }')"
fi

printf 'Analyzing repository history...\n'

TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TEMP_DIR"' EXIT
COMMITS_DATA="$TEMP_DIR/commits"
TODO_DATA="$TEMP_DIR/todo"
META_DATA="$TEMP_DIR/meta"

# Each commit starts with record separator 0x1e. Header fields use 0x1f;
# numstat rows that follow contain additions, deletions, and path.
git log --all --date=short \
    --format='%x1e%H%x1f%ad%x1f%at%x1f%aN%x1f%aE%x1f%s' \
    --numstat > "$COMMITS_DATA"

if [ -f "$TARGET_FILE" ]; then
    git log --follow --format='%H%x1f%ad' --date=short -- "$TARGET_FILE" |
    while IFS=$'\x1f' read -r hash date; do
        if content="$(git show "$hash:$TARGET_FILE" 2>/dev/null)"; then
            count="$(printf '%s\n' "$content" | awk 'NF { count++ } END { print count + 0 }')"
            printf '%s\x1f%s\x1e' "$date" "$count"
        fi
    done > "$TODO_DATA"
else
    : > "$TODO_DATA"
fi

REPO_NAME="$(basename "$REPO_ROOT")"
BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD)"
printf '%s\x1f%s\x1f%s\x1f%s' "$REPO_NAME" "$BRANCH" "$(date +%s)" "$TARGET_FILE" > "$META_DATA"

encode_file() {
    base64 < "$1" | tr -d '\n'
}

{
