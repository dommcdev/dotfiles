#!/usr/bin/env bash

set -euo pipefail

# --- DEPENDENCY CHECK ---
if ! command -v exiftool &> /dev/null; then
    echo "Error: exiftool is not installed." >&2
    echo "Please install it before running this script:" >&2
    echo "  Arch:   sudo pacman -S perl-image-exiftool" >&2
    echo "  Ubuntu: sudo apt install libimage-exiftool-perl" >&2
    exit 1
fi
# ------------------------

SRC_DIR="$HOME/photos/upload"
TARGET_DIR="$HOME/photos"
MISC_DIR="$TARGET_DIR/misc"

mkdir -p "$SRC_DIR" "$MISC_DIR"

shopt -s nullglob
files=("${SRC_DIR}"/*)

if [ ${#files[@]} -eq 0 ]; then
    echo "No files found in $SRC_DIR to process."
    exit 0
fi

# Regex pattern matching standard camera naming conventions:
# Group 1 (optional prefix): PXL_ or IMG_
# Group 2 (Year): 4 digits
# Group 3 (Month): 2 digits followed by 2 day digits and a separator
FILENAME_REGEX="^([A-Za-z0-9]*_)?([0-9]{4})([0-9]{2})[0-9]{2}[_.-]"

for file in "${files[@]}"; do
    [ -f "$file" ] || continue

    filename=$(basename "$file")
    SUB_DIR=""
    METHOD=""

    # Strategy 1: Check filename pattern first (Ultra-fast, in-memory)
    if [[ "$filename" =~ $FILENAME_REGEX ]]; then
        YEAR="${BASH_REMATCH[2]}"
        MONTH="${BASH_REMATCH[3]}"
        SUB_DIR="$YEAR/$MONTH"
        METHOD="Filename Fast-Path"
    else
        # Strategy 2: Fallback to ExifTool if filename pattern doesn't match
        EXIF_OUT=$(exiftool -d "%Y/%m" -p '$DateTimeOriginal' "$file" 2>/dev/null \
               || exiftool -d "%Y/%m" -p '$CreateDate' "$file" 2>/dev/null || true)

        if [ -n "$EXIF_OUT" ]; then
            SUB_DIR="$EXIF_OUT"
            METHOD="EXIF Fallback"
        fi
    fi

    # Execute the move operation
    if [ -n "$SUB_DIR" ]; then
        DEST="$TARGET_DIR/$SUB_DIR"
        mkdir -p "$DEST"
        mv "$file" "$DEST/"
        echo "Sorted ($METHOD): $filename -> $SUB_DIR/"
    else
        mv "$file" "$MISC_DIR/"
        echo "No date found via filename or EXIF. Moved to misc: $filename"
    fi
done

echo "Processing complete."
