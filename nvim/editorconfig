# EditorConfig: https://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{lua,beancount,yaml,json}]
indent_size = 2

[*.{c,cpp,java}]
indent_size = 4

[*.tte]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
