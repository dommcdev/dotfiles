paste-from-clipboard() {
    if command -v wl-paste >/dev/null; then
        LBUFFER+="$(wl-paste)"
    elif command -v pbpaste >/dev/null; then
        LBUFFER+="$(pbpaste)"
    fi
}

# Copy prompt to clipboad (keybind below)
copy-buffer-to-clipboard() {
   echo -n "$BUFFER" | wl-copy
   zle -M "Copied to clipboard"
}

# Run yazi with 'y', change cwd when exiting yazi
y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# Download as high-quality MP3
vaud() {
    yt-dlp -x --audio-format mp3 --audio-quality 0 "$1"
}

# Download video up to 1080p MP4
vid() {
    yt-dlp -f 'bv[height<=1080][ext=mp4]+ba[ext=m4a]/b[height<=1080][ext=mp4] / bv[height<=1080]+ba/b[height<=1080]' --merge-output-format mp4 "$1"
}

# Download absolute best quality available as MP4
vbest() {
    yt-dlp -f 'bv*+ba/b' --merge-output-format mp4 "$1"
}

# Call ghostty-sessionizer script to fuzzy-find project dir, then cd to it
fzf_project_jump() {
    local target_dir

    target_dir=$(ghostty-sessionizer.sh)

    if [[ -n "$target_dir" && -d "$target_dir" ]]; then
        cd "$target_dir"

        zle reset-prompt
    fi
}

rename-dirs() {
    setopt localoptions nullglob
    local dirs=([0-9]*\ -\ *(/))

    if (( ${#dirs} == 0 )); then
        echo "No directories found matching the pattern."
        return 0
    fi

    echo "The following renames will occur:"
    for dir in $dirs; do
        local num="${dir%% *}"
        local padded=$(printf "%02d" "$num")
        echo "  $dir  ->  $padded"
    done
    echo ""

    if read -q "reply?Proceed with renaming? (y/N): "; then
        echo "\n"
        for dir in $dirs; do
            local num="${dir%% *}"
            local padded=$(printf "%02d" "$num")
            mv "$dir" "$padded"
        done
        echo "All directories successfully renamed."
    else
        echo "\nAborted. No changes made."
    fi
}




